extends ../../layouts/default.pug

block main
  .page-header
    h1 Quản lý Tour
    a.btn-add(href="/admin/tours/create") + Thêm mới

  // CARD
  .tour-card

    .card-header
      .card-title
        h3 Danh sách tour du lịch

    .card-body

      .table-wrapper
        table.table
          thead
            tr
              th
                input(type="checkbox")

              th STT
              th Ảnh
              th Tên tour
              th Giá
              th Số lượng
              th Vị trí
              th Trạng thái
              th Hoạt động

          tbody
            each item, index in records
              tr
                td
                  input(type="checkbox")

                td.text-center #{index + 1}

                td.text-center
                  img.table-img(src=item.image)

                td
                  .tour-name #{item.title}

                td
                  span.price #{item.price.toLocaleString()}đ

                td.text-center
                  span.quantity #{item.stock}

                td.text-center
                  span.position #{item.position}

                td
                  span.badge.badge-success #{item.status == "active"? "Hoạt động" : "Dừng hoạt động"}

                td
                  .action-group
                    a.btn-edit(href=`/admin/tours/edit/${item.id}`) Sửa
                    a.btn-delete(href=`/admin/tours/delete/${item.id}`) Xóa
