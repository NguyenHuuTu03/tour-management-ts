extends ../../layouts/default
include ../../mixins/box-head

block main
  .cart-page
    .container
      +box-head("Giỏ hàng của bạn")

      form(form-order)

        // ================= TABLE =================
        table.cart-table
          thead
            tr
              th
                input(type="checkbox" checked)

              th Ảnh
              th Tên tour
              th Ngày khởi hành
              th Giá
              th Số lượng
              th Thành tiền
              th Hành động

          tbody(list-tour)

        // ================= TOTAL =================
        .cart-bottom
          .cart-total
            span Tổng đơn hàng: 
            strong(total-price)

        // ================= CUSTOMER INFO =================
        .customer-box
          +box-head("Thông tin khách hàng")

          .form-group
            label Họ và tên
            input(
              type="text"
              name="fullName"
            )

          .form-row
            .form-group
              label Số điện thoại
              input(
                type="text"
                name="phone"
              )

          .form-group
            label Ghi chú
            textarea(
              name="note"
              rows="4"
            ) 

          button.checkout-btn(type="submit")
            | Xác nhận đặt tour

block script 
  script(src="/client/js/cart.js") 