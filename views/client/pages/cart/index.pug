extends ../../layouts/default

block main
  .cart-page
    .container
      h1.cart-title Giỏ hàng của bạn

      form(action="/order" method="POST")

        // ================= TABLE =================
        table.cart-table
          thead
            tr
              th
                input(type="checkbox" checked)

              th Ảnh
              th Tên tour
              th Ngày khởi hành
              th Giá
              th Số lượng
              th Thành tiền
              th Hành động

          tbody(list-tour)
            tr
              td
                input(type="checkbox" checked)

              td
                img.cart-image(
                  src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e"
                  alt="Tour Đà Nẵng"
                )

              td
                .tour-name Tour Đà Nẵng 3N2Đ

              td 20/06/2026

              td 4.500.000đ

              td
                input.quantity-input(
                  type="number"
                  value="2"
                  min="1"
                )

              td.total-price 9.000.000đ

              td
                button.delete-btn(type="button") Xóa

            tr
              td
                input(type="checkbox" checked)

              td
                img.cart-image(
                  src="https://images.unsplash.com/photo-1528127269322-539801943592"
                  alt="Tour Phú Quốc"
                )

              td
                .tour-name Tour Phú Quốc 4N3Đ

              td 28/06/2026

              td 6.200.000đ

              td
                input.quantity-input(
                  type="number"
                  value="1"
                  min="1"
                )

              td.total-price 6.200.000đ

              td
                button.delete-btn(type="button") Xóa

        // ================= TOTAL =================
        .cart-bottom
          .cart-total
            span Tổng cộng: 
            strong(total-price) 15.200.000đ

        // ================= CUSTOMER INFO =================
        .customer-box
          h2.customer-title Thông tin khách hàng

          .form-group
            label Họ và tên
            input(
              type="text"
              name="fullName"
              value="Nguyễn Hữu Tú"
            )

          .form-row
            .form-group
              label Số điện thoại
              input(
                type="text"
                name="phone"
                value="0987654321"
              )

            .form-group
              label Email
              input(
                type="email"
                name="email"
                value="huutu2503@gmail.com"
              )

          .form-group
            label Địa chỉ
            input(
              type="text"
              name="address"
              value="Hoàn Kiếm, Hà Nội"
            )

          .form-group
            label Ghi chú
            textarea(
              name="note"
              rows="4"
            ) Tôi muốn được tư vấn thêm về lịch trình tour.

          button.checkout-btn(type="submit")
            | Xác nhận đặt tour

block script 
  script(src="/client/js/cart.js") 